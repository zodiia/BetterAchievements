{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JsonLayout",
    "type": "object",
    "required": [
        "achievementCategories"
    ],
    "properties": {
        "achievementCategories": {
            "type": "array",
            "items": { "$ref": "#/definitions/AchievementCategory" }
        }
    },
    "definitions": {
        "AchievementCategory": {
            "type": "object",
            "required": ["name"],
            "properties": {
                "name": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                },
                "seasonal": {
                    "type": "boolean"
                },
                "categories": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/AchievementCategory" }
                },
                "items": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/AchievementItem" }
                }
            },
            "oneOf": [
                { "required": ["categories"] },
                { "required": ["items"] }
            ]
        },
        "AchievementItem": {
            "type": "object",
            "properties": {
                "unique": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                    },
                    "minItems": 1
                },
                "tiered": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                    },
                    "minItems": 1
                },
                "spoilers": {
                    "type": "boolean"
                },
                "area": {
                    "type": "integer",
                },
                "huntingLog": {
                    "type": "integer",
                }
            },
            "oneOf": [
                { "required": ["unique"] },
                { "required": ["tiered"] }
            ]
        }
    }
}
